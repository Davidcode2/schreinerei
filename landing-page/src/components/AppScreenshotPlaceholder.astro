---
interface Props {
  title: string
  desktopImage: string
  desktopAlt: string
  mobileImage: string
  mobileAlt: string
  eyebrow: string
  description: string
}

const { title, desktopImage, desktopAlt, mobileImage, mobileAlt, eyebrow, description } = Astro.props
---

<article class="glass-card overflow-hidden">
  <div class="border-b border-border/70 px-5 py-4">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{eyebrow}</p>
    <h3 class="mt-2 text-2xl text-foreground">{title}</h3>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
  </div>
  <div class="bg-[linear-gradient(180deg,rgba(134,59,255,0.08),rgba(255,255,255,0.7))] p-4">
    <div class="relative">
      <img
        src={desktopImage}
        alt={desktopAlt}
        class="w-full rounded-[1.35rem] border border-white/70 bg-white shadow-[0_12px_40px_rgba(0,0,0,0.08)]"
        loading="lazy"
      />
      <img
        src={mobileImage}
        alt={mobileAlt}
        class="absolute bottom-4 right-4 hidden w-[22%] min-w-[5.8rem] rounded-[1.25rem] border border-white/80 bg-white shadow-[0_18px_50px_rgba(0,0,0,0.18)] sm:block"
        loading="lazy"
      />
    </div>
  </div>
  <div class="border-t border-border/50 px-5 py-3 text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground sm:hidden">
    Desktop und Mobile aufgenommen
  </div>
</article>
