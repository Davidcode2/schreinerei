---
import BaseLayout from "../layouts/BaseLayout.astro"
import AppScreenshotPlaceholder from "../components/AppScreenshotPlaceholder.astro"
const appUrl = (import.meta.env.PUBLIC_APP_URL ?? "http://localhost:5173").replace(/\/$/, "")
const loginUrl = appUrl + "/login"
const signupUrl = appUrl + "/signup"
const outcomes = [
  { number: "01", title: "Der Tag hat einen klaren Startpunkt.", copy: "Offene Punkte, fällige Wartungen und wichtige Projekte sind sichtbar, bevor sie zum Problem werden." },
  { number: "02", title: "Material und Zeit landen am richtigen Projekt.", copy: "Buchungen passieren dort, wo gearbeitet wird. Für weniger Rückfragen und eine Abrechnung, die nicht bei null beginnt." },
  { number: "03", title: "Werkzeug und Fahrzeuge bleiben planbar.", copy: "Reservierungen und Wartungen sind im Blick – damit nichts fehlt, wenn der Betrieb loslegt." },
]
const screenshots = [
  { eyebrow: "Tagesübersicht", title: "Wissen, was heute zählt.", description: "Der Startbildschirm bringt offene Punkte, Projektfortschritt und Hinweise zusammen – ohne dass dein Team erst danach suchen muss.", desktopImage: "/screenshots/dashboard-desktop.png", desktopAlt: "Desktop-Ansicht der Tagesübersicht in der Schreinerei-App", mobileImage: "/screenshots/dashboard-mobile.png", mobileAlt: "Mobile Ansicht der Tagesübersicht in der Schreinerei-App" },
  { eyebrow: "Projekte & Material", title: "Sauber zuordnen statt später zusammensuchen.", description: "Projekte, Material und Arbeitszeit bleiben miteinander verbunden. Das schafft eine verlässliche Grundlage für den nächsten Schritt.", desktopImage: "/screenshots/sites-desktop.png", desktopAlt: "Desktop-Ansicht der Projekte in der Schreinerei-App", mobileImage: "/screenshots/sites-mobile.png", mobileAlt: "Mobile Ansicht der Projekte in der Schreinerei-App" },
  { eyebrow: "Betriebsmittel", title: "Was unterwegs ist, bleibt sichtbar.", description: "Fahrzeuge, Werkzeuge und Wartungen sind dort organisiert, wo du sie im Alltag brauchst – nicht in einer weiteren Liste.", desktopImage: "/screenshots/fleet-desktop.png", desktopAlt: "Desktop-Ansicht des Fuhrparks in der Schreinerei-App", mobileImage: "/screenshots/fleet-mobile.png", mobileAlt: "Mobile Ansicht des Fuhrparks in der Schreinerei-App" },
]
const faqs = [
  { question: "Für wen ist die Schreinerei-App?", answer: "Für kleine Tischler- und Schreinerbetriebe, die ihren Alltag einfacher organisieren möchten – ohne eine überladene All-in-one-Software einzuführen." },
  { question: "Was kostet sie?", answer: "30 Euro pro Monat. Ein Tarif mit allen Kernfunktionen, ohne Paketvergleich und ohne Zusatzmodule für den normalen Arbeitsalltag." },
  { question: "Wie starte ich?", answer: "Du kannst direkt eine Organisation anlegen. Der Einstieg ist kurz gehalten, damit die App schnell in euren Arbeitsalltag passt." },
]
---

<BaseLayout title="Schreinerei-App | Dein Betrieb. Im Blick. Nicht im Kopf." description="Die Schreinerei-App organisiert Projekte, Material, Zeiten, Werkzeuge und Fahrzeuge für kleine Tischler- und Schreinerbetriebe – klar, einfach und alltagstauglich.">
  <header class="shell pt-4 sm:pt-6">
    <div class="site-nav">
      <a href="#top" class="flex min-w-0 items-center gap-3" aria-label="Schreinerei-App Startseite"><span class="brand-mark">S</span><span class="min-w-0"><span class="block truncate font-display text-xl leading-none text-foreground sm:text-2xl">Schreinerei-App</span><span class="mt-1 hidden text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted-foreground sm:block">Für Tischler & Schreiner</span></span></a>
      <nav class="hidden items-center gap-6 text-sm font-medium text-muted-foreground lg:flex" aria-label="Hauptnavigation"><a href="#alltag" class="hover:text-foreground">Im Alltag</a><a href="#einblicke" class="hover:text-foreground">Einblicke</a><a href="#preis" class="hover:text-foreground">Preis</a></nav>
      <div class="flex shrink-0 items-center gap-2 sm:gap-3"><a class="text-button hidden sm:inline-flex" href={loginUrl}>Login</a><a class="primary-button primary-button--compact" href={signupUrl}>Jetzt starten</a></div>
    </div>
  </header>
  <main id="top" class="overflow-x-hidden">
    <section class="shell hero-section"><div class="hero-glow" aria-hidden="true"></div><div class="relative grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div class="relative z-10"><p class="kicker">Betriebsorganisation für kleine Schreinereien</p><h1 class="mt-5 max-w-3xl text-[clamp(3.15rem,9vw,6.5rem)] leading-[0.88] text-foreground">Dein Betrieb.<br /><em>Im Blick.</em><br />Nicht im Kopf.</h1><p class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground md:text-xl">Projekte, Material, Arbeitszeit und Betriebsmittel an einem ruhigen Ort. Damit der Tag nicht mit Suchen, Nachfragen und Zetteln beginnt.</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="primary-button" href={signupUrl}>Betrieb einfacher organisieren</a><a class="secondary-button" href="#einblicke">App ansehen</a></div><div class="proof-row mt-9" aria-label="Die wichtigsten Vorteile"><p><strong>30 €</strong><span>pro Monat</span></p><p><strong>1 Tarif</strong><span>alle Kernfunktionen</span></p><p><strong>Für euch</strong><span>Tischler & Schreiner</span></p></div></div>
      <div class="product-window relative"><div class="product-window__bar"><span class="flex gap-1.5" aria-hidden="true"><i></i><i></i><i></i></span><span>Heute im Betrieb</span><span class="hidden sm:block">Schreinerei-App</span></div><img src="/screenshots/dashboard-desktop.png" alt="Tagesübersicht der Schreinerei-App mit Projekten und Aufgaben" class="block w-full" /><div class="hero-note"><span class="hero-note__dot"></span><p><strong>Weniger merken müssen.</strong><br />Mehr sauber erledigen.</p></div></div>
    </div></section>
    <section class="shell pb-14 md:pb-24" aria-label="Was die App organisiert"><div class="quiet-strip"><p class="kicker">Ein Ort für den Alltag</p><div class="mt-5 grid gap-4 border-t border-border/60 pt-5 sm:grid-cols-3"><p><strong>Projekte</strong><span>Aufträge und offene Punkte</span></p><p><strong>Material & Zeit</strong><span>Direkt richtig zugeordnet</span></p><p><strong>Werkzeug & Fahrzeuge</strong><span>Verfügbar und gewartet</span></p></div></div></section>
    <section id="alltag" class="shell section-space"><div class="max-w-3xl"><p class="kicker">Ein ruhigerer Arbeitstag</p><h2 class="mt-5 text-4xl leading-[0.98] text-foreground sm:text-5xl">Die wichtigen Dinge bleiben da, wo dein Team sie findet.</h2><p class="mt-5 section-copy">Keine Software um der Software willen. Sondern klare Informationen genau dann, wenn ihr sie für die Arbeit braucht.</p></div><div class="mt-10 divide-y divide-border/70 border-y border-border/70">{outcomes.map((outcome) => <article class="outcome-row"><p class="outcome-number">{outcome.number}</p><h3>{outcome.title}</h3><p>{outcome.copy}</p></article>)}</div></section>
    <section id="einblicke" class="shell section-space"><div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:items-end"><div><p class="kicker">Einblicke in die App</p><h2 class="mt-5 text-4xl leading-[0.98] text-foreground sm:text-5xl">Klar, auch wenn der Tag es nicht ist.</h2></div><p class="section-copy lg:justify-self-end">Die App schafft Übersicht für den echten Betriebsalltag – auf dem Rechner im Büro und auf dem Handy unterwegs.</p></div><div class="mt-10 grid gap-6 lg:grid-cols-2">{screenshots.slice(0, 2).map((card) => <AppScreenshotPlaceholder {...card} />)}</div><div class="mt-6 lg:mx-auto lg:max-w-[calc(50%-0.75rem)]"><AppScreenshotPlaceholder {...screenshots[2]} /></div></section>
    <section id="preis" class="shell section-space"><div class="price-panel"><div><p class="kicker text-primary-foreground/75">Einfacher Preis</p><h2 class="mt-5 text-4xl leading-[0.98] text-primary-foreground sm:text-5xl">Alles, was du brauchst. Ohne Tarifzirkus.</h2><p class="mt-5 max-w-xl text-base leading-7 text-primary-foreground/80">Ein Preis für die Kernfunktionen, die einen kleinen Betrieb im Alltag weiterbringen. Ohne Funktionspakete, die man erst verstehen muss.</p></div><div class="price-card"><p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Schreinerei-App</p><p class="mt-4 font-display text-7xl leading-none text-foreground">30 <span class="text-2xl">€</span></p><p class="mt-2 text-sm text-muted-foreground">pro Monat · alle Kernfunktionen</p><a class="primary-button mt-7 w-full" href={signupUrl}>Jetzt starten</a><p class="mt-4 text-center text-xs text-muted-foreground">Organisation anlegen und direkt loslegen</p></div></div></section>
    <section class="shell section-space"><div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]"><div><p class="kicker">Kurz beantwortet</p><h2 class="mt-5 text-4xl leading-[0.98] text-foreground sm:text-5xl">Vor dem Start.</h2></div><div class="divide-y divide-border/70 border-y border-border/70">{faqs.map((faq, index) => <details class="faq-item" open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
    <section class="shell pb-16 pt-2 md:pb-24"><div class="closing-panel"><p class="kicker">Dein nächster Schritt</p><h2 class="mt-5 max-w-3xl text-4xl leading-[0.98] text-foreground sm:text-5xl">Weniger organisieren. Mehr gute Arbeit machen.</h2><p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground">Schau dir die Schreinerei-App an und entscheide dann, ob sie zu eurem Betrieb passt.</p><div class="mt-7 flex flex-col gap-3 sm:flex-row"><a class="primary-button" href={signupUrl}>Schreinerei-App starten</a><a class="text-button justify-center" href={loginUrl}>Zum Login</a></div></div></section>
  </main>
  <footer class="shell pb-8"><div class="flex flex-col gap-4 border-t border-border/70 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"><p>Schreinerei-App · Für kleine Schreinereien und Tischlereien</p><div class="flex items-center gap-5"><a href="/impressum" class="hover:text-foreground">Impressum</a><a href={loginUrl} class="hover:text-foreground">Login</a></div></div></footer>
</BaseLayout>
