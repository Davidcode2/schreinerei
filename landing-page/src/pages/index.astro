---
import BaseLayout from "../layouts/BaseLayout.astro"
import AppScreenshotPlaceholder from "../components/AppScreenshotPlaceholder.astro"

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? "http://localhost:5173").replace(/\/$/, "")
const loginUrl = `${appUrl}/login`
const signupUrl = `${appUrl}/signup`

const features = [
  {
    title: "Weniger hinterhertelefonieren",
    copy: "Baustellen, Werkstattaufträge und offene Punkte stehen an einem Ort. So muss niemand morgens erst fragen, was heute dran ist.",
  },
  {
    title: "Material im Blick",
    copy: "Du siehst, was da ist, was fehlt und was entnommen wurde. Das spart Sucherei im Lager und teure spontane Nachkäufe.",
  },
  {
    title: "Maschinen und Fahrzeuge nicht vergessen",
    copy: "Reservierungen, Verfügbarkeit und anstehende Wartungen bleiben sichtbar, damit wichtige Dinge nicht erst auffallen, wenn es zu spät ist.",
  },
  {
    title: "Stunden direkt erfassen",
    copy: "Arbeitszeiten landen sofort im System statt abends auf Zetteln. Das spart Rückfragen und macht die Abrechnung am Ende einfacher.",
  },
  {
    title: "Schnell verstanden",
    copy: "Die Schreinerei-App ist für kleine Handwerksbetriebe gemacht, die arbeiten wollen und nicht erst lange eine Software lernen möchten.",
  },
  {
    title: "Passt zu Tischlern und Schreinern",
    copy: "Die Sprache, die Abläufe und die Prioritäten passen zu Betrieben, die mit Holz arbeiten und ihren Alltag sauber organisieren wollen.",
  },
]

const faqs = [
  {
    question: "Für wen ist die Schreinerei-App gedacht?",
    answer: "Für kleine Handwerksbetriebe aus dem Tischler- und Schreinerhandwerk, die weniger Zeit mit Papierkram, Nachfragen und Erinnerungschaos verbringen wollen.",
  },
  {
    question: "Was kostet die Schreinerei-App?",
    answer: "30 Euro pro Monat. Ein Tarif, alle Kernfunktionen drin. Kein Rechnen, kein Paketvergleich, kein Zusatzmodul für jeden nächsten Schritt.",
  },
  {
    question: "Kann ich direkt loslegen?",
    answer: "Ja. Du kommst direkt in den Login oder zur Organisationserstellung. Der Einstieg ist bewusst kurz gehalten, damit du nicht erst durch einen langen Vertriebsprozess musst.",
  },
  {
    question: "Warum nicht einfach Plancraft oder HERO?",
    answer: "Plancraft und HERO sind starke Lösungen für viele Gewerke und viele Prozesse. Die Schreinerei-App ist die bewusst einfachere Wahl für kleine Tischler- und Schreinerbetriebe, die vor allem weniger Verwaltungsaufwand wollen.",
  },
]

const comparisonRows = [
  {
    label: "Fokus auf kleine Schreinereien & Tischlereien",
    schreinerei: "Klarer Schwerpunkt",
    plancraft: "Breiter aufgestellt",
    hero: "Breiter aufgestellt",
  },
  {
    label: "Preismodell",
    schreinerei: "1 Tarif, 30 EUR",
    plancraft: "Mehrere Pakete",
    hero: "Breiteres Setup",
  },
  {
    label: "Produktansatz",
    schreinerei: "Schlank und alltagsnah",
    plancraft: "Breite Handwerkerplattform",
    hero: "Umfangreiches Betriebssystem",
  },
  {
    label: "Einstieg für kleine Teams",
    schreinerei: "Direkt und übersichtlich",
    plancraft: "Mehr Funktionen, mehr Auswahl",
    hero: "Mehr Funktionen, mehr Komplexität",
  },
  {
    label: "Geeignet für",
    schreinerei: "Kleine Tischler- und Schreinerbetriebe",
    plancraft: "Viele Gewerke und Betriebsgrößen",
    hero: "Viele Gewerke und wachsende Betriebe",
  },
]

const screenshotCards = [
  {
    eyebrow: "Dashboard",
    title: "Tageslage auf einen Blick",
    description: "Der Startbildschirm zeigt Projektstatus, Materialwarnungen und erfasste Stunden in einer klaren Übersicht für Inhaber und Büro.",
    desktopImage: "/screenshots/dashboard-desktop.png",
    desktopAlt: "Desktop-Screenshot des Schreinerei-Dashboards",
    mobileImage: "/screenshots/dashboard-mobile.png",
    mobileAlt: "Mobiler Screenshot des Schreinerei-Dashboards",
  },
  {
    eyebrow: "Projekte",
    title: "Baustellen und Werkstattprojekte im Raster",
    description: "Die Projektliste verbindet Suche, Statusfilter und Kartenansicht für externe Baustellen und interne Werkstattaufträge in einer Oberfläche.",
    desktopImage: "/screenshots/sites-desktop.png",
    desktopAlt: "Desktop-Screenshot der Projekte-Seite in Schreinerei",
    mobileImage: "/screenshots/sites-mobile.png",
    mobileAlt: "Mobiler Screenshot der Projekte-Seite in Schreinerei",
  },
  {
    eyebrow: "Fuhrpark",
    title: "Fahrzeuge mit Reservierungen im Griff",
    description: "Der Fuhrparkbereich zeigt Fahrzeuge, Status und Reservierungen so, dass dein Team sofort sieht, was verfügbar und was schon eingeplant ist.",
    desktopImage: "/screenshots/fleet-desktop.png",
    desktopAlt: "Desktop-Screenshot der Fuhrpark-Seite in Schreinerei",
    mobileImage: "/screenshots/fleet-mobile.png",
    mobileAlt: "Mobiler Screenshot der Fuhrpark-Seite in Schreinerei",
  },
  {
    eyebrow: "Werkzeuge",
    title: "Werkzeugbestand separat und sauber organisiert",
    description: "Werkzeuge bekommen ihre eigene klare Oberfläche statt in einer allgemeinen Ressourcenansicht unterzugehen. Das passt zum Alltag kleiner Teams.",
    desktopImage: "/screenshots/tools-desktop.png",
    desktopAlt: "Desktop-Screenshot der Werkzeuge-Seite in Schreinerei",
    mobileImage: "/screenshots/tools-mobile.png",
    mobileAlt: "Mobiler Screenshot der Werkzeuge-Seite in Schreinerei",
  },
  {
    eyebrow: "Inventar",
    title: "Materialsuche, Kategorien und Warnungen an einem Ort",
    description: "Das Inventar verbindet Suche, Kategorien und Ablaufwarnungen, damit Materialfragen nicht erst zwischen Lagerregal und Telefon geklärt werden müssen.",
    desktopImage: "/screenshots/inventory-desktop.png",
    desktopAlt: "Desktop-Screenshot der Inventar-Seite in Schreinerei",
    mobileImage: "/screenshots/inventory-mobile.png",
    mobileAlt: "Mobiler Screenshot der Inventar-Seite in Schreinerei",
  },
  {
    eyebrow: "Einstellungen",
    title: "Profil, Abrechnung und Teamverwaltung ohne Umwege",
    description: "Auch die Verwaltungsbereiche bleiben in derselben klaren Sprache: sauber gegliederte Karten für Profil, Rechnungsdaten und Benutzerverwaltung.",
    desktopImage: "/screenshots/settings-desktop.png",
    desktopAlt: "Desktop-Screenshot der Einstellungen-Seite in Schreinerei",
    mobileImage: "/screenshots/settings-mobile.png",
    mobileAlt: "Mobiler Screenshot der Einstellungen-Seite in Schreinerei",
  },
]
---

<BaseLayout
  title="Schreinerei-App | Weniger Papierkram für Tischler und Schreiner"
  description="Die Schreinerei-App hilft kleinen Tischler- und Schreinerbetrieben, Projekte, Material, Werkzeuge, Fahrzeuge und Zeiten ohne Verwaltungschaos zu organisieren."
>
  <header class="shell pt-6">
    <div class="glass-card flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
      <a href="#top" class="flex items-center gap-3">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary text-xl font-bold text-primary-foreground shadow-lg shadow-primary/20">S</span>
        <span>
          <span class="block font-display text-2xl leading-none text-foreground">Schreinerei-App</span>
          <span class="block pt-1 text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Für Tischler- und Schreinerbetriebe</span>
        </span>
      </a>

      <nav class="hidden items-center gap-6 text-sm font-medium text-muted-foreground md:flex">
        <a href="#funktionen" class="hover:text-foreground">Funktionen</a>
        <a href="#einblicke" class="hover:text-foreground">Einblicke</a>
        <a href="#preise" class="hover:text-foreground">Preise</a>
        <a href="#vergleich" class="hover:text-foreground">Vergleich</a>
      </nav>

      <div class="flex items-center gap-3">
        <a class="secondary-button hidden sm:inline-flex" href={loginUrl}>Login</a>
        <a class="primary-button" href={signupUrl}>Jetzt starten</a>
      </div>
    </div>
  </header>

  <main id="top" class="noise overflow-x-hidden">
    <section class="shell relative pt-14 pb-14 md:pt-20 md:pb-24">
      <div class="absolute left-[8%] top-14 -z-10 h-36 w-36 rounded-full bg-primary/16 blur-3xl"></div>
      <div class="absolute right-[10%] top-36 -z-10 h-52 w-52 rounded-full bg-primary/10 blur-3xl"></div>

      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
        <div>
          <span class="eyebrow">Für kleine Handwerksbetriebe im Tischler- und Schreinerhandwerk</span>
          <h1 class="mt-6 max-w-4xl text-5xl leading-[0.95] text-foreground sm:text-6xl lg:text-7xl">
            Weniger Papierkram. Weniger Nachdenken über Orga. Mehr Zeit fürs eigentliche Handwerk.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground md:text-xl">
            Die Schreinerei-App nimmt kleinen Tischler- und Schreinerbetrieben Verwaltungsarbeit ab. Damit Rechnungen,
            Material, Maschinen, Fahrzeuge und Arbeitszeiten nicht mehr im Kopf, auf Zetteln oder zwischen Telefonaten
            hängen bleiben.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="primary-button" href={signupUrl}>Jetzt einfacher organisieren</a>
            <a class="secondary-button" href={loginUrl}>Zum Login</a>
          </div>

          <div class="mt-8 grid max-w-2xl gap-4 sm:grid-cols-3">
            <div class="glass-card px-5 py-4">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Preis</p>
              <p class="mt-2 text-3xl font-bold text-foreground">30 EUR</p>
              <p class="mt-1 text-sm text-muted-foreground">pro Monat, ohne Tariflogik</p>
            </div>
            <div class="glass-card px-5 py-4">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Ausrichtung</p>
              <p class="mt-2 text-3xl font-bold text-foreground">1 Ziel</p>
              <p class="mt-1 text-sm text-muted-foreground">weniger Verwaltungsaufwand</p>
            </div>
            <div class="glass-card px-5 py-4">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Einrichtung</p>
              <p class="mt-2 text-3xl font-bold text-foreground">Schnell</p>
              <p class="mt-1 text-sm text-muted-foreground">im Alltag verstanden</p>
            </div>
          </div>
        </div>

        <div class="glass-card relative overflow-hidden rounded-[2rem] p-4 md:p-6">
          <div class="absolute inset-x-10 top-0 h-24 rounded-full bg-primary/15 blur-3xl"></div>
          <div class="relative rounded-[1.6rem] border border-white/70 bg-[linear-gradient(160deg,rgba(134,59,255,0.13),rgba(255,255,255,0.95)_42%,rgba(237,230,255,0.75))] p-5 shadow-[0_30px_80px_rgba(106,45,204,0.16)]">
            <div class="flex items-center justify-between gap-4 border-b border-white/70 pb-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">Schreinerei-App</p>
                <h2 class="mt-2 text-3xl text-foreground">Damit weniger liegen bleibt</h2>
              </div>
              <span class="rounded-full border border-primary/15 bg-white px-3 py-1 text-xs font-semibold text-primary">PWA</span>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-[1.15fr_0.85fr]">
              <div class="rounded-[1.4rem] border border-white/80 bg-white/90 p-4 shadow-sm">
                <div class="flex items-center justify-between">
                  <p class="text-sm font-semibold text-foreground">Heute im Betrieb</p>
                  <span class="rounded-full bg-accent px-3 py-1 text-xs font-medium text-accent-foreground">Live</span>
                </div>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-2xl bg-secondary/80 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Projekte</p>
                    <p class="mt-2 text-3xl font-bold text-foreground">8</p>
                    <p class="mt-1 text-sm text-muted-foreground">2 kritisch, 6 im Plan</p>
                  </div>
                  <div class="rounded-2xl bg-secondary/80 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Material</p>
                    <p class="mt-2 text-3xl font-bold text-foreground">24</p>
                    <p class="mt-1 text-sm text-muted-foreground">Bestandsänderungen diese Woche</p>
                  </div>
                  <div class="rounded-2xl bg-secondary/80 p-4 sm:col-span-2">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Heute wichtig</p>
                    <div class="mt-3 space-y-3">
                      <div class="flex items-center justify-between rounded-xl border border-border/70 px-3 py-2">
                        <span class="text-sm font-medium text-foreground">Fensterbau Schubert</span>
                        <span class="text-xs text-muted-foreground">3 Mitarbeiter</span>
                      </div>
                      <div class="flex items-center justify-between rounded-xl border border-border/70 px-3 py-2">
                        <span class="text-sm font-medium text-foreground">Innenausbau Lenz</span>
                        <span class="text-xs text-muted-foreground">12.5 h gebucht</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="space-y-4">
                <div class="rounded-[1.4rem] border border-white/80 bg-white/90 p-4 shadow-sm">
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Warum das für den Alltag zählt</p>
                  <ul class="mt-3 space-y-3 text-sm leading-6 text-foreground">
                    <li>Weniger Dinge im Kopf behalten müssen.</li>
                    <li>Weniger Rückfragen zwischen Baustelle, Werkstatt und Büro.</li>
                    <li>Weniger Zeit für Organisation, mehr Zeit für saubere Arbeit.</li>
                  </ul>
                </div>
                <div class="rounded-[1.4rem] bg-primary p-5 text-primary-foreground shadow-lg shadow-primary/20">
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-foreground/80">Für kleine Betriebe gemacht</p>
                  <p class="mt-2 text-3xl font-bold">30 EUR monatlich</p>
                  <p class="mt-2 text-sm leading-6 text-primary-foreground/85">Ein Tarif. Klare Funktionen. Kein unnötiger Ballast für Betriebe, die einfach besser organisiert arbeiten wollen.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="shell pb-12 md:pb-20">
      <div class="glass-card grid gap-5 px-6 py-6 md:grid-cols-4 md:px-8">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Weniger Verwaltungsaufwand</p>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Die Schreinerei-App richtet sich an Betriebe, die nicht von Software träumen, sondern von einem ruhigeren Arbeitstag ohne ständiges Hinterherorganisieren.</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Fokus</p>
          <p class="mt-2 text-lg font-semibold text-foreground">Tischler und Schreiner</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">Positionierung</p>
          <p class="mt-2 text-lg font-semibold text-foreground">Praktisch statt aufgeblasen</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">CTA</p>
          <p class="mt-2 text-lg font-semibold text-foreground">Schnell verstehen, schnell nutzen</p>
        </div>
      </div>
    </section>

    <section id="funktionen" class="shell py-14 md:py-20">
      <span class="eyebrow">Worum es im Alltag wirklich geht</span>
      <div class="mt-5 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="max-w-3xl text-4xl leading-tight text-foreground sm:text-5xl">Du willst arbeiten, nicht ständig Zettel suchen, Material prüfen oder Termine im Kopf behalten.</h2>
        </div>
        <p class="section-copy">
          Genau dafür ist die Schreinerei-App da: Sie nimmt kleinen Handwerksbetrieben die organisatorischen Dinge ab,
          die Zeit, Nerven und Konzentration kosten, obwohl sie nichts mit guter handwerklicher Arbeit zu tun haben.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {features.map((feature) => (
          <article class="glass-card p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent text-primary">
              <span class="text-lg font-bold">S</span>
            </div>
            <h3 class="mt-5 text-2xl text-foreground">{feature.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted-foreground">{feature.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="einblicke" class="shell py-14 md:py-20">
      <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <span class="eyebrow">Produkt-Einblicke</span>
          <h2 class="mt-5 text-4xl leading-tight text-foreground sm:text-5xl">Zeige, wie weniger Orga-Stress im Alltag aussieht.</h2>
          <p class="mt-4 section-copy">
            Die Einblicke unten sind direkt aus dem laufenden Frontend aufgenommen. Jede Karte kombiniert Desktop-
            und Mobile-Ansicht derselben Route, damit sofort klar wird: Hier geht es nicht um schöne Software, sondern
            darum, dass wichtige Dinge im Betrieb nicht untergehen.
          </p>
        </div>
        <div class="glass-card px-5 py-4 text-sm leading-6 text-muted-foreground">
          Gezeigt werden die Kernrouten für den täglichen Betrieb: Projekte, Material, Werkzeuge,
          Fahrzeuge, Zeiten und Einstellungen immer dort, wo sie gebraucht werden.
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {screenshotCards.map((card) => (
          <AppScreenshotPlaceholder
            eyebrow={card.eyebrow}
            title={card.title}
            description={card.description}
            desktopImage={card.desktopImage}
            desktopAlt={card.desktopAlt}
            mobileImage={card.mobileImage}
            mobileAlt={card.mobileAlt}
          />
        ))}
      </div>
    </section>

    <section id="preise" class="shell py-14 md:py-20">
      <div class="glass-card overflow-hidden">
        <div class="grid gap-0 lg:grid-cols-[0.92fr_1.08fr]">
          <div class="bg-[linear-gradient(180deg,rgba(106,45,204,0.96),rgba(85,34,173,0.98))] px-7 py-8 text-primary-foreground md:px-10 md:py-10">
            <span class="inline-flex rounded-full border border-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em]">Preise</span>
            <h2 class="mt-5 text-4xl leading-tight sm:text-5xl">Ein Preis, der zu kleinen Betrieben passt.</h2>
            <p class="mt-4 max-w-lg text-base leading-7 text-primary-foreground/85">
              Wer den ganzen Tag auf Baustellen, in der Werkstatt oder beim Kunden ist, will nicht erst Preislisten
              vergleichen. Deshalb gibt es bei der Schreinerei-App bewusst nur ein Modell: 30 Euro pro Monat.
            </p>
          </div>

          <div class="grid gap-6 px-7 py-8 md:px-10 md:py-10 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="rounded-[1.75rem] border border-primary/15 bg-accent/45 p-6">
              <p class="text-sm font-semibold uppercase tracking-[0.22em] text-primary">Schreinerei-App</p>
              <p class="mt-4 text-6xl font-bold text-foreground">30</p>
              <p class="mt-1 text-lg font-semibold text-foreground">EUR / Monat</p>
              <p class="mt-4 text-sm leading-7 text-muted-foreground">
                Alle Kernfunktionen drin. Keine Add-ons. Keine Staffelung. Keine Diskussion darüber, was im Alltag noch extra kostet.
              </p>
              <a class="primary-button mt-6 w-full" href={signupUrl}>Einfach loslegen</a>
            </div>

            <div class="space-y-4">
              {[
                "Weniger Papierkram bei Projekten und Baustellen",
                "Material, das nicht erst gesucht werden muss",
                "Arbeitszeiten ohne Stundenzettel-Chaos",
                "Werkzeuge, Fahrzeuge und Wartungen im Blick",
                "Ein Einstieg ohne langes Erklären",
                "Eine Oberfläche, die man im Alltag schnell versteht",
              ].map((item) => (
                <div class="flex items-start gap-3 rounded-2xl border border-border/70 bg-white px-4 py-4">
                  <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-success"></span>
                  <p class="text-sm leading-6 text-foreground">{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="vergleich" class="shell py-14 md:py-20">
      <span class="eyebrow">Marktvergleich</span>
      <div class="mt-5 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <h2 class="max-w-3xl text-4xl leading-tight text-foreground sm:text-5xl">Warum die Schreinerei-App neben Plancraft und HERO einen klaren Platz hat.</h2>
        <p class="section-copy">
          Plancraft und HERO sind für viele Handwerksbetriebe interessante Lösungen. Die Schreinerei-App setzt bewusst
          enger an: für Tischler und Schreiner, die vor allem ihren Verwaltungsaufwand klein halten wollen.
        </p>
      </div>

      <div class="mt-8 overflow-hidden rounded-[2rem] border border-border/70 bg-white shadow-[0_20px_70px_rgba(0,0,0,0.08)]">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="bg-secondary/55 text-sm">
              <th class="px-5 py-4 font-semibold text-muted-foreground">Kriterium</th>
              <th class="px-5 py-4 font-semibold text-primary">Schreinerei-App</th>
              <th class="px-5 py-4 font-semibold text-foreground">Plancraft</th>
              <th class="px-5 py-4 font-semibold text-foreground">HERO</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-t border-border/70 align-top">
                <td class="px-5 py-4 text-sm font-medium text-foreground">{row.label}</td>
                <td class="px-5 py-4 text-sm text-primary">{row.schreinerei}</td>
                <td class="px-5 py-4 text-sm text-muted-foreground">{row.plancraft}</td>
                <td class="px-5 py-4 text-sm text-muted-foreground">{row.hero}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-sm leading-6 text-muted-foreground">
        Vergleich auf Basis der öffentlichen Positionierung und Seitenstruktur von Plancraft und HERO. Beide Lösungen
        adressieren den Handwerksmarkt deutlich breiter, während die Schreinerei-App bewusst enger und alltagsnäher für
        kleine Tischler- und Schreinerbetriebe positioniert ist.
      </p>
    </section>

    <section class="shell py-14 md:py-20">
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <span class="eyebrow">FAQ</span>
          <h2 class="mt-5 text-4xl leading-tight text-foreground sm:text-5xl">Die wichtigsten Fragen vor dem Start.</h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="glass-card group px-6 py-5" open={faq.question === faqs[0].question}>
              <summary class="cursor-pointer list-none text-lg font-semibold text-foreground marker:hidden">{faq.question}</summary>
              <p class="mt-3 pr-8 text-sm leading-7 text-muted-foreground">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="shell pt-6 pb-16 md:pb-24">
      <div class="glass-card relative overflow-hidden rounded-[2.25rem] bg-[linear-gradient(135deg,rgba(134,59,255,0.14),rgba(255,255,255,0.9)_38%,rgba(237,230,255,0.65))] px-7 py-10 md:px-12 md:py-14">
        <div class="absolute -right-10 -top-8 h-40 w-40 rounded-full bg-primary/18 blur-3xl"></div>
        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <span class="eyebrow">Nächster Schritt</span>
            <h2 class="mt-5 max-w-3xl text-4xl leading-tight text-foreground sm:text-5xl">Wenn du weniger organisieren musst, bleibt mehr Energie für gute Arbeit.</h2>
            <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">
              Die Schreinerei-App ist für kleine Handwerksbetriebe gedacht, die nicht noch mehr Software wollen,
              sondern weniger Dinge, an die sie ständig denken müssen. Schau dir an, ob genau dieser Fokus zu deinem
              Betrieb passt.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <a class="secondary-button" href={loginUrl}>Zum Login</a>
            <a class="primary-button" href={signupUrl}>Schreinerei-App starten</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="shell pb-10">
    <div class="flex flex-col gap-4 border-t border-border/70 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>Schreinerei-App für kleine Schreinereien und Tischlereien in Deutschland.</p>
      <div class="flex items-center gap-5">
        <a href="/impressum" class="hover:text-foreground">Impressum</a>
        <a href={loginUrl} class="hover:text-foreground">Login</a>
        <a href={signupUrl} class="hover:text-foreground">Starten</a>
      </div>
    </div>
  </footer>
</BaseLayout>
