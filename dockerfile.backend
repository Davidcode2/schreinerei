FROM rust:1.89-bookworm AS chef

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install --locked cargo-chef --version 0.1.77

WORKDIR /app

ENV SQLX_OFFLINE=true

FROM chef AS planner

COPY . .

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json

RUN cargo chef cook --release --recipe-path recipe.json

COPY . .

RUN cargo build --release --bin schreinerei

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --uid 10001 schreinerei

WORKDIR /app

COPY --from=builder /app/target/release/schreinerei /usr/local/bin/schreinerei
COPY migrations ./migrations

USER 10001:10001

ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

CMD ["schreinerei"]
